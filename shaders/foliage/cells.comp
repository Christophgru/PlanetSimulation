    if(uPreviousSlots>0) {
        uint slot=cellHash(key.xyz)&uint(uPreviousSlots-1);
        for(int probe=0;probe<uPreviousSlots;++probe) {
            uint entry=previousTable[slot];if(entry==0u) break;
            Cell old=previous[entry-1u];
            if(all(equal(old.key.xyz,key.xyz))) {
