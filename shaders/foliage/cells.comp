#version 430 core
layout(local_size_x=64) in;
struct Cell {uvec4 key,geometry,span;vec4 metric;};
layout(std430,binding=0) readonly buffer References {uint triangles[];};
layout(std430,binding=1) writeonly buffer Cells {Cell cells[];};
layout(std430,binding=2) buffer Table {uint table[];};
layout(std430,binding=3) readonly buffer PreviousCells {Cell previous[];};
layout(std430,binding=4) readonly buffer PreviousTable {uint previousTable[];};
layout(std430,binding=5) buffer Summary {uint totals[8];};
layout(std430,binding=6) writeonly buffer Bounds {vec4 bounds[];};
uniform samplerBuffer uTerrainVertices;
uniform usamplerBuffer uTerrainIndices;
uniform int uCellFirst,uFirstPatch,uFirstRoot,uSlots,uOffset,uEnd,uTableSlots,uPreviousSlots;
uniform bool uCanReuse;
uniform float uScale,uDensity;
uint cellHash(uvec3 key) {
    uint h=key.x^(key.y<<11u)^(key.z>>7u);
    h^=h>>16u;h*=0x7feb352du;h^=h>>15u;h*=0x846ca68bu;return h^(h>>16u);
}
vec3 vectorAt(uint v,int offset) {
    int i=int(v)*9+offset;
    return vec3(texelFetch(uTerrainVertices,i).r,texelFetch(uTerrainVertices,i+1).r,texelFetch(uTerrainVertices,i+2).r);
