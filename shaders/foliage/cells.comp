    uint vertices[3];vec3 p[3];uvec3 fingerprint=uvec3(2166136261u,0x9e3779b9u,0x85ebca6bu);
    for(int c=0;c<3;++c) {
        uint corner=(key.w>>uint(c*2))&3u;
        vertices[c]=texelFetch(uTerrainIndices,int(t)*3+int(corner)).r;p[c]=vectorAt(vertices[c],0);
        for(int offset=0;offset<9;offset+=3) {
            uvec3 bits=floatBitsToUint(vectorAt(vertices[c],offset));
            for(int component=0;component<3;++component) fingerprint=(fingerprint^bits[component])*16777619u;
        }
    }
    vec3 center=(p[0]+p[1]+p[2])/3.0;
    float reach=max(max(length(p[0]-center),length(p[1]-center)),length(p[2]-center));
    float expected=.5*length(cross(p[1]-p[0],p[2]-p[0]))*uScale*uScale*uDensity;
    Cell cell=Cell(key,uvec4(fingerprint,0),uvec4(uint(uFirstRoot)+id*uint(uSlots),uint(uSlots),0xffffffffu,0),vec4(expected,0,0,0));
