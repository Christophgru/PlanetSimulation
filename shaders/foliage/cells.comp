    for(int probe=0;probe<uTableSlots;++probe) {
        if(atomicCompSwap(table[slot],0u,index+1u)==0u) return;
        slot=(slot+1u)&uint(uTableSlots-1);
    }
    atomicAdd(totals[6],1u);
}
